# SeniorRouter free pool: names only. Set the ones you have as Windows USER environment variables:
#   setx GROQ_API_KEY "..."
# The router reads them from the user environment (no restart needed) and never writes them to disk or to git.
# Only providers with a key are used. Free tiers may use prompts for training: mark sensitive projects confidential.

GROQ_API_KEY=            # https://console.groq.com  (no card)
CLOUDFLARE_API_KEY=      # https://dash.cloudflare.com -> AI -> Workers AI -> API token
CLOUDFLARE_ACCOUNT_ID=   # same dashboard (not secret, but per-account)
MISTRAL_API_KEY=         # https://console.mistral.ai  (Experiment plan for chat models; codestral works on most keys)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (":free" models; 50 req/day, 1000 after a one-time $10 top-up)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (used for Gemma in the pool)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai  (optional)
